<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D-025: short buzz between routine steps (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- R-007: daily reminder. Asked only when the user turns a reminder on; all else works without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- D-037: keep a routine running with the screen off (foreground service that plays the
         spoken cues and chimes; wake lock so the timer keeps ticking). No prompts for these. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the app find the phone's built-in text-to-speech engine (Android 11+). No Internet. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_stretch" android:roundIcon="@drawable/ic_launcher_stretch"
        android:label="Stretch" android:supportsRtl="true" android:theme="@style/Theme.Stretch">
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".settings.ReminderReceiver" android:exported="false" />
        <service android:name=".run.RunService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
